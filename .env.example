POSTGRES_USER=postgres
POSTGRES_PASSWORD=saas_password
POSTGRES_DB=saas_db
DATABASE_URL=postgres://postgres:saas_password@db:5432/saas_db?sslmode=disable

RABBITMQ_DEFAULT_USER=rabbit_user
RABBITMQ_DEFAULT_PASS=rabbit_password
RABBITMQ_DEFAULT_VHOST=my_vhost
RABBITMQ_URL=amqp://rabbit_user:rabbit_password@rabbitmq:5672/my_vhost


REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@localhost:6379/0


APP_ENV=local

AUTH_APP_PORT=8080
DEPLOY_APP_PORT=8080
STATUS_APP_PORT=8080
CATALOG_APP_PORT=8080

JWT_SECRET=super-secret-key-123