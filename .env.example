# --- DATABASES ---
# Auth DB
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=<set-me-auth>
AUTH_DB_NAME=auth_db
AUTH_DATABASE_URL=postgres://postgres:${AUTH_DB_PASSWORD}@auth_db:5432/auth_db?sslmode=disable
AUTH_SERVICE_NAME=auth

# Status DB
STATUS_DB_USER=postgres
STATUS_DB_PASSWORD=<set-me-status>
STATUS_DB_NAME=status_db
STATUS_DATABASE_URL=postgres://postgres:${STATUS_DB_PASSWORD}@status_db:5432/status_db?sslmode=disable
STATUS_SERVICE_NAME=status

# Catalog DB
CATALOG_DB_USER=postgres
CATALOG_DB_PASSWORD=<set-me-catalog>
CATALOG_DB_NAME=catalog_db
CATALOG_DATABASE_URL=postgres://postgres:${CATALOG_DB_PASSWORD}@catalog_db:5432/catalog_db?sslmode=disable
CATALOG_SERVICE_NAME=catalog


# --- RABBITMQ ---
RABBITMQ_DEFAULT_USER=rabbit_user
RABBITMQ_DEFAULT_PASS=<set-me-rabbit>
RABBITMQ_DEFAULT_VHOST=my_vhost
RABBITMQ_URL=amqp://rabbit_user:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/my_vhost


# --- REDIS ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<set-me-redis>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0


# --- APP SETTINGS ---
APP_ENV=local

AUTH_APP_PORT=8080
DEPLOY_APP_PORT=8080
STATUS_APP_PORT=8080
CATALOG_APP_PORT=8080

JWT_SECRET=<generate-256-bit-secret>

INTERNAL_API_TOKEN=<generate-256-bit-token>